(defun (find-page pid plist)
  (cond
    [(eq? plist empty) empty]
    [(in? pid (list (car (car plist))))
      (car plist)]
    [#t
      (find-page pid (cdr plist))]))

(defun (get-page-by-url url)
  (find-page url pages))

